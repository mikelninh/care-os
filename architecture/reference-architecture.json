{
  "schema_version": "1.3",
  "architecture_version": "2.3",
  "baseline_date": "2026-08-18",
  "name": "CareOS Federated Clinical Context Layer",
  "reference_architecture_readiness": {
    "state": "proposal-ready",
    "meaning": "architecturally reviewable for serious discussion; not production approval, clinical validation or self-certification"
  },
  "production_claim": "not-production-ready",
  "live_patient_data_allowed": false,
  "agent_live_identifiable_phi_allowed": false,
  "system_of_record": false,
  "routine_phi_in_control_plane": false,
  "default_data_locality": "provider-data-plane",
  "default_clinical_mode": "read-only",
  "autonomous_clinical_writeback": false,
  "autonomous_agent_consequential_actions": false,
  "architecture_principles": [
    "source-system-authority",
    "provider-side-phi",
    "mandatory-provenance",
    "explicit-unknown-and-failure-state",
    "models-are-untrusted-proposers",
    "agents-are-separate-narrow-delegated-principals",
    "agent-worker-cannot-choose-authoritative-patient-context",
    "single-use-agent-delegation",
    "read-write-capability-separation",
    "strong-patient-identity-before-auto-attach",
    "explicit-cross-source-patient-identity",
    "same-patient-context-no-second-search",
    "composition-not-core-forks",
    "adapter-maturity-is-machine-readable",
    "hospital-upgrades-require-compatibility-preflight",
    "least-privilege-treatment-context",
    "deny-default-agent-egress",
    "fail-visible",
    "evidence-backed-gates"
  ],
  "planes": {
    "control_plane": {
      "routine_identifiable_phi": false,
      "allowed": [
        "signed-releases",
        "pack-versions",
        "policy-and-config-schemas",
        "terminology-and-guideline-metadata",
        "connector-capability-definitions",
        "adapter-compatibility-metadata",
        "synthetic-conformance-suites",
        "agent-tool-capability-definitions",
        "non-phi-operational-metadata"
      ]
    },
    "provider_data_plane": {
      "identifiable_clinical_processing": true,
      "components": [
        "hospital-capability-manifest",
        "connector-gateway",
        "patient-and-encounter-identity",
        "clinical-truth-layer",
        "terminology-and-temporal-policy",
        "reconciliation-and-review",
        "authorization-policy",
        "agent-delegation-authority",
        "agent-workload-identity",
        "agent-gateway",
        "agent-tool-proxy",
        "provider-audit",
        "clinician-ui"
      ]
    }
  },
  "trust_contracts": {
    "hospital_manifest": ["site", "source-system-role", "vendor-product-version", "interfaces", "secret-references-only", "patient-identity-strategy", "read-write-capability", "accountable-owners"],
    "connector": ["capabilities", "source-identity", "truth-envelope", "source-state", "version-and-time", "read-write-capability"],
    "clinical_fact": ["patient", "fact-type", "original-value", "source", "source-version", "evidence", "effective-time", "ingestion-time", "transformer-version", "trust-status", "review-state"],
    "access": ["user", "organisation", "role-scope", "patient", "encounter-or-treatment-context", "operation"],
    "agent_workload_identity": ["subject", "organisation", "agent", "version", "audience", "credential-id", "short-validity", "revocation"],
    "agent_delegation": ["unique-jti", "human-delegator", "organisation", "patient", "encounter", "task", "tools", "operations", "data-categories", "budgets", "expiry", "single-use"],
    "agent_tool": ["stable-id-and-version", "effect", "target-system", "data-categories", "egress", "limits", "audit", "human-confirmation"],
    "agent_worker": ["untrusted-proposals-only", "no-authoritative-patient-context", "no-break-glass", "no-egress-selection", "review-only-source-linked-draft"],
    "failure": ["current", "stale", "unavailable", "unknown", "contradictory", "explicitly-negative"],
    "audit": ["actor", "organisation", "patient-reference", "data-category", "action", "time", "origin", "break-glass-context"],
    "agent_audit": ["human-delegator", "agent-and-version", "delegation", "execution", "patient-reference", "tool", "authorization-decision", "egress", "outcome"]
  },
  "adapter_maturity": {
    "source": "architecture/adapter-catalog.json",
    "fhir-r4-read": "implemented",
    "isik-fhir-read": "validation-path",
    "hl7v2": "contract-only",
    "vendor-api": "contract-only",
    "document-feed": "contract-only",
    "ui-bridge": "contract-only",
    "live-write": "unsupported-current-release"
  },
  "agent_operating_modes": {
    "synthetic": "implemented",
    "deidentified-sandbox": "implemented-contract",
    "shadow-live": "implemented-but-locked",
    "read-only-live": "implemented-but-locked",
    "consequential": "unsupported"
  },
  "deployment_patterns": [
    "provider-on-prem-or-private-infrastructure",
