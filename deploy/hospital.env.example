# NON-SECRET EXAMPLE ONLY.
# Copy to a hospital-controlled secret/environment mechanism. Never commit real tokens.

CAREOS_DATA_MODE=synthetic
CAREOS_EXTERNAL_DEIDENTIFIED_ACK=false

# Package-level guard uses this default source. The hospital runtime resolves each
# source below from the variable names referenced by hospital.json.
FHIR_BASE_URL=http://localhost:8080/fhir

# Example source endpoints. Keep loopback/local for synthetic mode.
KIS_FHIR_BASE_URL=http://localhost:8080/fhir
LIS_FHIR_BASE_URL=http://localhost:8081/fhir

# Leave credentials empty for local no-auth synthetic servers and set the matching
# source authentication_mode to `synthetic-none`. For real approved deidentified
# endpoints, inject bearer values through a hospital secret store instead of this file.
KIS_FHIR_TOKEN=
LIS_FHIR_TOKEN=
